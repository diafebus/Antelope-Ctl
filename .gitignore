# Raw USB captures -- large binaries, kept locally only (see CAPTURING.md)
captures/
*.pcapng
*.pcap

# Local reference images (Launcher UI screenshots, terminal grabs) -- local only
screenshots/

# Bulky tshark exports -- regenerate from the pcapng when needed
*.tsv
captures/*.txt
/vumeters-sinewave*.txt

# Python
__pycache__/
*.pyc
.venv/

# Local CLI cache (link state) lives in ~/.cache/antelope-ctl, not here, but just in case
*.cache

# Local handoff, open-task queue and optional plans
SUMMARY.md
AUDIT.md
KERNEL.md
APPIMAGE-PLAN.md

# Local Unity analytics and account session token
/Unity/
/settings.xml

# Local diagnostic tool output (may contain the device serial)
tools/*_out.txt

# Local WebUI design references; they are not application assets.
/webui/ideas/
/webui/examples/

# For other query that aren't necessarily related or relevant to the main repository
sidejob/
CAPTURE-REQUESTS.md
